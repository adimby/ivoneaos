# Copier en .env.local et remplir. Ne jamais committer de valeurs.
# En local : `npx supabase status` donne l'URL et les clés.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Serveur uniquement (jamais préfixées NEXT_PUBLIC_).
# Client secret Supabase : webhooks, cron et compteurs des limites de connexion
# (sans elle, seules les limites de Supabase s'appliquent).
SUPABASE_SECRET_KEY=
# Clé AES-256-GCM des secrets Papi/Whop : 32 octets en base64 (openssl rand -base64 32).
PAYMENT_SECRETS_KEY=
# Optionnelles : la fonctionnalité correspondante est désactivée si absente.
RESEND_API_KEY=
# API Resend (défaut : https://api.resend.com). Tests de bout en bout seulement
# (e2e/resend-mock.mjs, qui remet les e-mails à Mailpit) ; refusée en production.
RESEND_API_BASE_URL=
# Adresse publique de l'app, pour les liens des e-mails et les retours Papi/Whop
# (ex. https://app.ivonea.com). Obligatoire en production (construction refusée sans elle).
# À défaut (développement, tests) : l'origine de la requête.
APP_URL=
# Expéditeur des e-mails (défaut : Ivonea OS <notifications@ivonea.com>).
EMAIL_FROM=
# Protège /api/cron/* (Vercel l'envoie en « Authorization: Bearer … »).
CRON_SECRET=
# Paiement par carte (factures EUR/USD) : clé API de la plateforme Whop ET secret du
# webhook, les deux sont nécessaires. L'une ou l'autre absente : Whop est masqué partout
# (sans webhook, un paiement par carte ne serait jamais enregistré).
WHOP_API_KEY=
# Secret du webhook Whop de la plateforme (ws_…), avec les événements des comptes
# connectés (child_resource_events), URL <APP_URL>/api/whop/webhook.
WHOP_WEBHOOK_SECRET=
# Commission de la plateforme sur chaque paiement Whop, en % (défaut 0).
WHOP_PLATFORM_FEE_PERCENT=
# API Whop (défaut : https://api.whop.com/api/v1). Tests de bout en bout seulement
# (e2e/whop-mock.mjs).
WHOP_API_BASE_URL=
# Adresse d'Ivonea affichée dans Réglages > Offre pour changer d'offre. Obligatoire en
# production (la construction Vercel échoue sans elle) ; ailleurs, sans elle : pas de lien.
IVONEA_CONTACT_EMAIL=
# API Papi (défaut : https://app.papi.mg/engine/api). À ne renseigner que pour les tests
# de bout en bout, qui la remplacent par un Papi simulé (e2e/papi-mock.mjs).
PAPI_API_BASE_URL=
